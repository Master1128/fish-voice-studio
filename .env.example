# Copia este archivo a .env.local y rellena tus keys (opcional: también
# pueden configurarse desde la propia interfaz, botón "API Keys")

# Vercel AI Gateway — necesaria para TTS y transcripción
# https://vercel.com/dashboard/ai-gateway/keys
AI_GATEWAY_API_KEY=

# Fish Audio — opcional: clonación de voces, voces privadas y modo directo
# https://fish.audio/settings/api-keys
FISH_AUDIO_API_KEY=
